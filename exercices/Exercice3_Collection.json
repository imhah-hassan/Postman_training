		{
			"name": "GetFlight",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"pm.test(\"FlightNumber string is present\", function () {\r",
							"    pm.expect(pm.response.text()).to.include(\"FlightNumber\");\r",
							"});\r",
							"pm.test(\"Flight day is Tuesday\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.DayOfWeek).to.eql(\"Tuesday\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{endpoint}}/Flights/10487",
					"host": [
						"{{endpoint}}"
					],
					"path": [
						"Flights",
						"10487"
					]
				}
			},
			"response": []
